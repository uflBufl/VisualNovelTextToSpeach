        "line_ids": [
          "reverse1999:202527:44"
        ],
        "catalog": "Uncle Zhōu might be a little stubborn, but, you know gah-lah, that's just what he's like. Don't take it personally.",
        "asr": "Uncle Joe might be a little stubborn, but you know Gala, that's just what he's like. Don't take it personally."
      }
