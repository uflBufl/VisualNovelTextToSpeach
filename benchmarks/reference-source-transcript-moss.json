    "minimum_token_edits": 3,
    "minimum_edit_fraction": 0.25,
    "unit": "Sum of maximum unequal span lengths from SequenceMatcher over normalized words, divided by the longer word count. A missing lexical transcript makes the decision uncertain."
  },
