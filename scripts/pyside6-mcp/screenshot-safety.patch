index 0000000..ed977ad
--- /dev/null
+++ b/tests/test_shutdown.py
@@ -0,0 +1,212 @@
+"""Quit acknowledgement is distinct from actual owned-process termination."""
+import json
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import httpx
+import pytest
+
+from pyside6_mcp import bridge, server
+from pyside6_mcp.session import SessionRegistry
+
+
+def _stop():
+    return getattr(server.stop_app, "fn", server.stop_app)(pid=123)
+
+
+@pytest.fixture
+def session(monkeypatch):
+    sessions = SessionRegistry()
+    proc = Mock(pid=456, returncode=0)
+    proc.poll.return_value = 0
+    session = sessions.add(pid=123, port=9876, proc=proc, log_path="fixture.log")
+    monkeypatch.setattr(server, "_sessions", sessions)
+    monkeypatch.setattr(server, "_drop_client", Mock())
+    monkeypatch.setattr(server, "_request_app_quit", Mock(return_value={"quit": {"ok": True}}))
+    monkeypatch.setattr(server, "_kill_proc_tree", Mock())
+    monkeypatch.setattr(server.time, "sleep", Mock())
+    return session
+
+
+def test_acknowledged_quit_waits_for_actual_app_exit(session, monkeypatch):
+    alive = Mock(side_effect=[True, False, False, False])
+    monkeypatch.setattr(server, "_app_alive", alive)
+    result = json.loads(_stop())
+    assert result["ok"] is True
+    assert alive.call_count >= 2
+    server.time.sleep.assert_called_once()
+    assert server._sessions.get(123) is None
+
+
+def test_lost_ack_with_exited_process_is_success(session, monkeypatch):
+    server._request_app_quit.return_value = {"quit_error": "response closed"}
+    monkeypatch.setattr(server, "_app_alive", lambda _: False)
+    result = json.loads(_stop())
+    assert result["ok"] is True
+    assert result["quit"]["quit_error"] == "response closed"
+    assert server._sessions.get(123) is None
+
+
+def test_exited_wrapper_does_not_prove_app_exit_or_signal_foreign_group(session, monkeypatch):
+    monkeypatch.setattr(server, "_app_alive", lambda _: True)
+    monkeypatch.setattr(server.time, "monotonic", Mock(side_effect=[0, 6]))
+    monkeypatch.setattr(server.os, "getpgid", lambda _: 789)
+    kill = Mock()
+    monkeypatch.setattr(server.os, "killpg", kill)
+    result = json.loads(_stop())
+    assert result["ok"] is False
+    assert "retained" in result["error"]
+    assert server._sessions.get(123) is session
+    kill.assert_not_called()
+    server._kill_proc_tree.assert_not_called()
+
+
+def test_unresponsive_owned_launcher_gets_existing_force_cleanup(session, monkeypatch):
+    session.proc.poll.return_value = None
+    monkeypatch.setattr(server, "_app_alive", Mock(side_effect=[True, False]))
+    monkeypatch.setattr(server.time, "monotonic", Mock(side_effect=[0, 6]))
+    result = json.loads(_stop())
+    assert result["ok"] is True
+    server._kill_proc_tree.assert_called_once_with(session.proc)
+
+
+def test_app_liveness_checks_real_qt_pid_instead_of_exited_wrapper(session, monkeypatch):
+    kill = Mock()
+    monkeypatch.setattr(server.os, "kill", kill)
+    assert server._app_alive(session) is True
+    kill.assert_called_once_with(123, 0)
+    kill.side_effect = ProcessLookupError
+    assert server._app_alive(session) is False
+
+
+def test_quit_transport_timeout_does_not_claim_process_stopped(monkeypatch):
+    monkeypatch.setattr(server.httpx, "post", Mock(side_effect=httpx.ReadTimeout("slow")))
+    result = server._request_app_quit(9876, timeout=2)
+    assert "quit_error" in result
+    assert "bridge_stopped" not in result
+    server.httpx.post.assert_called_once_with("http://127.0.0.1:9876/quit", timeout=2)
+
+
+def test_bridge_flushes_ack_before_queuing_quit(monkeypatch):
+    events = []
+    handler = object.__new__(bridge._Handler)
+    handler.path = "/quit"
+    handler._body = lambda: {}
+    handler._send = lambda data, status=200: events.append(("ack", data))
+    handler.wfile = SimpleNamespace(flush=lambda: events.append("flush"))
+    monkeypatch.setattr(bridge.QMetaObject, "invokeMethod", lambda *args: events.append("quit"))
+    handler.do_POST()
+    assert events == [("ack", {"ok": True}), "flush", "quit"]
+
+
+def test_http_ack_precedes_about_to_quit_cleanup(tmp_path, free_port):
+    import os
+    import subprocess
+    import sys
+    import time
+
+    fixture = tmp_path / "quit_fixture.py"
+    release = tmp_path / "release"
+    finished = tmp_path / "finished"
+    fixture.write_text(
+        "import time\n"
+        "from pathlib import Path\n"
+        "from PySide6.QtWidgets import QApplication, QWidget\n"
+        "from pyside6_mcp.bridge import install_bridge\n"
+        "app = QApplication([])\n"
+        "window = QWidget(); window.show()\n"
+        "def cleanup():\n"
+        "    deadline = time.monotonic() + 5\n"
+        f"    while not Path({str(release)!r}).exists() and time.monotonic() < deadline:\n"
+        "        time.sleep(0.01)\n"
+        f"    Path({str(finished)!r}).touch()\n"
+        "app.aboutToQuit.connect(cleanup)\n"
+        f"install_bridge({free_port})\n"
+        "app.exec()\n"
+    )
+    proc = subprocess.Popen([sys.executable, str(fixture)],
+                            env={**os.environ, "QT_QPA_PLATFORM": "offscreen"})
+    base = f"http://127.0.0.1:{free_port}"
+    try:
+        deadline = time.monotonic() + 5
+        while True:
+            try:
+                if httpx.get(base + "/app", timeout=0.3).status_code == 200:
+                    break
+            except httpx.HTTPError:
+                if time.monotonic() >= deadline:
+                    raise
+                time.sleep(0.02)
+        response = httpx.post(base + "/quit", timeout=2)
+        assert response.json() == {"ok": True}
+        assert not finished.exists(), "quit acknowledgement must precede cleanup completion"
+        assert proc.poll() is None
+        release.touch()
+        assert proc.wait(timeout=5) == 0
+        assert finished.exists()
+    finally:
+        release.touch()
+        if proc.poll() is None:
+            proc.terminate()
+            proc.wait(timeout=5)
+
+
+@pytest.mark.parametrize("status,expected", [(0x102, True), (0, False)])
+def test_windows_liveness_uses_readonly_wait_and_closes_pointer_sized_handle(
+    session, monkeypatch, status, expected
+):
+    import ctypes
+    from ctypes import wintypes
+
+    handle = 0x100001234
+    kernel = SimpleNamespace(
+        OpenProcess=Mock(return_value=handle),
+        WaitForSingleObject=Mock(return_value=status),
+        CloseHandle=Mock(return_value=True),
+    )
+    monkeypatch.setattr(server.sys, "platform", "win32")
+    load = Mock(return_value=kernel)
+    monkeypatch.setattr(ctypes, "WinDLL", load, raising=False)
+    monkeypatch.setattr(ctypes, "get_last_error", lambda: 0, raising=False)
+    kill = Mock(side_effect=AssertionError("Windows liveness must never call os.kill"))
+    monkeypatch.setattr(server.os, "kill", kill)
+    assert server._app_alive(session) is expected
+    load.assert_called_once_with("kernel32", use_last_error=True)
+    kernel.OpenProcess.assert_called_once_with(0x00100000, False, 123)
+    assert kernel.OpenProcess.restype is wintypes.HANDLE
+    assert kernel.WaitForSingleObject.argtypes == [wintypes.HANDLE, wintypes.DWORD]
+    kernel.WaitForSingleObject.assert_called_once_with(handle, 0)
+    kernel.CloseHandle.assert_called_once_with(handle)
+    kill.assert_not_called()
+
+
