+"""One-shot QAction invocation acknowledges nested modal loops truthfully."""
+import json
+import os
+import subprocess
+import sys
+import time
+from unittest.mock import Mock
+
+import httpx
+import pytest
+from PySide6.QtWidgets import QApplication
+
+from pyside6_mcp import bridge, server
+
+
+def test_queued_invocation_does_not_claim_dispatch_or_completion(monkeypatch):
+    app = QApplication.instance() or QApplication([])
+    events = []
+    effects = []
+    monkeypatch.setattr(app, "postEvent", lambda receiver, event: events.append(event))
+    result, status = bridge._dispatch_main(lambda: effects.append("once") or {"ok": True},
+                                          timeout=0)
+    assert status == 202
+    assert result["state"] == "queued"
+    assert result["ok"] is True
+    assert result["invocation_id"]
+    assert effects == []
+    # The original event is retained, not re-posted/retried when acknowledgement
+    # times out. Later processing executes the accepted invocation once.
+    assert len(events) == 1
+    events[0].func()
+    assert effects == ["once"]
+    assert len(events) == 2  # the second event only acknowledges the nested loop
+    events[1].func()
+    assert effects == ["once"]
+
+
+def test_trigger_action_preserves_incomplete_state_and_posts_once(monkeypatch):
+    response = {"ok": True, "state": "dispatched", "invocation_id": "fixture"}
+    post = Mock(return_value=response)
+    monkeypatch.setattr(server, "_post", post)
+    trigger = getattr(server.trigger_action, "fn", server.trigger_action)
+    assert json.loads(trigger(name="modal", pid=123)) == response
+    post.assert_called_once_with("/action", {"name": "modal"}, pid=123)
+
+
+@pytest.fixture
+def action_app(tmp_path, free_port):
+    fixture = tmp_path / "action_fixture.py"
+    calls = tmp_path / "calls"
+    finished = tmp_path / "finished"
+    fixture.write_text(
+        "from pathlib import Path\n"
+        "from PySide6.QtCore import QTimer\n"
+        "from PySide6.QtGui import QAction\n"
+        "from PySide6.QtWidgets import QApplication, QDialog, QWidget\n"
+        "from shiboken6 import delete\n"
+        "from pyside6_mcp.bridge import install_bridge\n"
+        "app = QApplication([])\n"
+        "window = QWidget(); window.show()\n"
+        "dialog = None\n"
+        f"calls = Path({str(calls)!r})\n"
+        "def record(name):\n"
+        "    calls.write_text((calls.read_text() if calls.exists() else '') + name + '\\n')\n"
+        "def modal(name='modal'):\n"
+        "    global dialog\n"
+        "    record(name)\n"
+        "    dialog = QDialog(window); dialog.setObjectName('activeModal')\n"
+        "    dialog.exec()\n"
+        f"    Path({str(finished)!r}).touch()\n"
+        "class FailingAction(QAction):\n"
+        "    def trigger(self):\n"
+        "        raise RuntimeError('genuine invocation failure')\n"
+        "class LateFailingAction(QAction):\n"
+        "    def trigger(self):\n"
+        "        super().trigger()\n"
+        "        raise RuntimeError('failure after modal return')\n"
+        "def add(name, callback=None, cls=QAction):\n"
+        "    action = cls(name, window); action.setObjectName(name)\n"
+        "    if callback is not None: action.triggered.connect(callback)\n"
+        "    window.addAction(action)\n"
+        "    return action\n"
+        "normal = add('normal', lambda: record('normal'))\n"
+        "modal_action = add('modal', lambda: modal())\n"
+        "late_failure = add('modalFailure', lambda: modal('modalFailure'), cls=LateFailingAction)\n"
+        "close = add('closeModal', lambda: dialog.accept())\n"
+        "failure = add('failure', cls=FailingAction)\n"
+        "disabled = add('disabled', lambda: record('disabled')); disabled.setEnabled(False)\n"
+        "stale = add('stale', lambda: record('stale')); delete(stale)\n"
+        f"install_bridge({free_port})\n"
+        "QTimer.singleShot(10000, app.quit)\n"
+        "app.exec()\n"
+    )
+    proc = subprocess.Popen([sys.executable, str(fixture)],
+                            env={**os.environ, "QT_QPA_PLATFORM": "offscreen"})
+    base = f"http://127.0.0.1:{free_port}"
+    try:
+        deadline = time.monotonic() + 5
+        while True:
+            try:
+                if httpx.get(base + "/app", timeout=0.3).status_code == 200:
+                    break
+            except httpx.HTTPError:
+                if proc.poll() is not None or time.monotonic() >= deadline:
+                    raise
+                time.sleep(0.02)
+        yield base, calls, finished
+    finally:
+        if proc.poll() is None:
+            proc.terminate()
+            proc.wait(timeout=5)
+
+
+def test_modal_exec_http_ack_is_dispatched_while_dialog_stays_open(action_app):
+    base, calls, finished = action_app
+    response = httpx.post(base + "/action", json={"name": "modal"}, timeout=2)
+    assert response.status_code == 202, response.text
+    result = response.json()
+    assert result["state"] == "dispatched"
+    assert result["ok"] is True
+    assert "triggered" not in result  # trigger() has not returned
+    assert result["invocation_id"]
+    assert calls.read_text().splitlines() == ["modal"]
+    assert not finished.exists(), "ack must precede the modal action's return"
+    visible = httpx.post(base + "/find", json={"class": "QDialog", "visible": True},
+                         timeout=2).json()["widgets"]
+    assert any(widget["object_name"] == "activeModal" for widget in visible)
+    closed = httpx.post(base + "/action", json={"name": "closeModal"}, timeout=2)
+    assert closed.status_code == 200
+    assert closed.json()["state"] == "completed"
+    deadline = time.monotonic() + 2
+    while not finished.exists() and time.monotonic() < deadline:
+        time.sleep(0.01)
+    assert finished.exists()
+    assert calls.read_text().splitlines() == ["modal"]
+
+
+def test_normal_completion_and_genuine_action_errors_remain_observable(action_app):
+    base, calls, _ = action_app
+    response = httpx.post(base + "/action", json={"name": "normal"}, timeout=2)
+    assert response.status_code == 200
+    assert response.json()["state"] == "completed"
+    assert response.json()["triggered"] == "normal"
+    assert calls.read_text().splitlines() == ["normal"]
+    for name, detail in [("disabled", "disabled"), ("stale", "not found"),
+                         ("missing", "not found")]:
+        response = httpx.post(base + "/action", json={"name": name}, timeout=2)
+        assert response.status_code == 200  # retain validation error contract
+        assert response.json()["state"] == "error"
+        assert detail in response.json()["error"]
+    response = httpx.post(base + "/action", json={}, timeout=2)
+    assert response.json()["state"] == "error"
+    assert "Provide" in response.json()["error"]
+    response = httpx.post(base + "/action", json={"name": "failure"}, timeout=2)
+    assert response.status_code == 500
+    assert response.json()["state"] == "error"
+    assert response.json()["error"] == "genuine invocation failure"
+    logs = httpx.get(base + "/logs", timeout=2).json()["logs"]
+    assert any(response.json()["invocation_id"] in record["message"] for record in logs)
+    assert calls.read_text().splitlines() == ["normal"]
+
+
+def test_error_after_dispatch_is_correlated_in_existing_logs(action_app):
+    base, calls, finished = action_app
+    response = httpx.post(base + "/action", json={"name": "modalFailure"}, timeout=2)
+    assert response.status_code == 202
+    result = response.json()
+    assert result["state"] == "dispatched"
+    assert not finished.exists()
+    assert httpx.post(base + "/action", json={"name": "closeModal"}, timeout=2).status_code == 200
+    deadline = time.monotonic() + 2
+    while True:
+        logs = httpx.get(base + "/logs", timeout=2).json()["logs"]
+        if any(result["invocation_id"] in record["message"] and
+               "failure after modal return" in record["message"] for record in logs):
+            break
+        assert time.monotonic() < deadline, logs
+        time.sleep(0.01)
+    assert calls.read_text().splitlines() == ["modalFailure"]
