+    assert bridge._qt_press_key({"key": "Ctrl+A"}) == {"ok": True}
+    assert editor.selectedText() == "previous"
+    assert bridge._qt_type(bridge._widget_id(editor), {"text": "new"}) == {"ok": True}
+    assert editor.text() == "new"
+    assert bridge._qt_press_key({"key": "backspace"}) == {"ok": True}
+    assert editor.text() == "ne"
+    assert bridge._qt_press_key({"key": "A"}) == {"ok": True}
+    assert editor.text() == "neA"
+
+
+@pytest.mark.parametrize("key", ["Ctrl+Bogus", "Ctrl+A, Ctrl+B", "unsupported", ""])
+def test_invalid_key_combinations_do_not_type(app, key):
+    editor = QLineEdit("unchanged")
