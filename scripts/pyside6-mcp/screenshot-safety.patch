+@pytest.mark.parametrize("error", [server.httpx.ReadError, server.httpx.RemoteProtocolError])
+@pytest.mark.parametrize("path", ["/widget/owned/click", "/action"])
+def test_mutating_post_is_not_repeated_after_effect_with_lost_response(monkeypatch, error, path):
+    effects = []
+
+    def request(method, path, **kwargs):
+        effects.append((method, path, kwargs))
+        raise error("response lost after action")
+
+    client = Mock(request=Mock(side_effect=request))
+    sessions = server.SessionRegistry()
+    sessions.add(pid=123, port=9876, proc=None, log_path="fixture.log")
+    monkeypatch.setattr(server, "_sessions", sessions)
+    monkeypatch.setattr(server, "_client_for", lambda port: client)
+    sleep = Mock()
+    monkeypatch.setattr(server.time, "sleep", sleep)
+    with pytest.raises(RuntimeError, match="may have completed"):
+        server._post(path, {"button": "left"}, pid=123)
+    assert effects == [("POST", path, {"json": {"button": "left"}})]
+    client.request.assert_called_once()
+    sleep.assert_not_called()
+
+
+@pytest.mark.parametrize("error", [server.httpx.ReadError, server.httpx.RemoteProtocolError])
+def test_safe_get_still_retries_transient_response_errors(monkeypatch, error):
+    response = server.httpx.Response(200, json={"ok": True},
+                                    request=server.httpx.Request("GET", "http://127.0.0.1/app"))
+    client = Mock(request=Mock(side_effect=[error("lost"), response]))
+    sessions = server.SessionRegistry()
+    sessions.add(pid=123, port=9876, proc=None, log_path="fixture.log")
+    monkeypatch.setattr(server, "_sessions", sessions)
+    monkeypatch.setattr(server, "_client_for", lambda port: client)
+    sleep = Mock()
+    monkeypatch.setattr(server.time, "sleep", sleep)
+    assert server._get("/app", pid=123) == {"ok": True}
+    assert client.request.call_count == 2
+    sleep.assert_called_once_with(server._RETRY_BACKOFFS[0])
+
+
+def test_native_qt_lifetime_property_is_excluded_from_widget_info_http(app, monkeypatch):
+    from PySide6.QtCore import QBuffer, QByteArray, QIODevice
+    from PySide6.QtUiTools import QUiLoader
+    from PySide6.QtWidgets import QPlainTextEdit
+
+    ui = QByteArray(b'<ui version="4.0"><class>Form</class><widget class="QWidget" '
+                    b'name="Form"><widget class="QPlainTextEdit" name="nativeEditor">'
+                    b'<property name="plainText"><string>fixture text</string></property>'
+                    b'</widget></widget><resources/><connections/></ui>')
+    buffer = QBuffer()
+    buffer.setData(ui)
+    buffer.open(QIODevice.OpenModeFlag.ReadOnly)
+    window = QUiLoader().load(buffer)
+    editor = window.findChild(QPlainTextEdit, "nativeEditor")
+    window.show()
+    app.processEvents()
+    editor.setProperty("user_value", "readable")
+    names = [bytes(key).decode() for key in editor.dynamicPropertyNames()]
+    assert "_PySideInvalidatePtr" in names, "fixture must create a native Qt wrapper"
+    wid = bridge._widget_id(editor)
+    handler = object.__new__(bridge._Handler)
+    handler.path = "/widget/" + wid
+    responses = []
+    handler._send = lambda data, status=200: responses.append((status, data))
+    monkeypatch.setattr(bridge, "_call_main", lambda fn: fn())
+    handler.do_GET()
+    status, result = responses[0]
+    assert status == 200, result
+    assert result["class"] == "QPlainTextEdit"
+    assert result["text"] == "fixture text"
+    assert result["visible"] is True
+    assert result["geometry"]["w"] > 0
+    assert result["dynamic_properties"] == {"user_value": "readable"}
+
+
+def test_widget_info_preserves_unexpected_application_property_errors(app, monkeypatch):
+    class Editor(QLineEdit):
+        def property(self, name):
+            if name == "application_value":
+                raise RuntimeError("application property read failed")
+            return super().property(name)
+
+    editor = Editor()
+    editor.setProperty("application_value", "value")
+    handler = object.__new__(bridge._Handler)
+    handler.path = "/widget/" + bridge._widget_id(editor)
+    responses = []
+    handler._send = lambda data, status=200: responses.append((status, data))
+    monkeypatch.setattr(bridge, "_call_main", lambda fn: fn())
+    handler.do_GET()
+    assert responses == [(500, {"error": "application property read failed"})]
