+def test_click_dispatches_once_and_preserves_bridge_response(monkeypatch):
+    post = Mock(return_value={"error": "Widget 'stale' not found"})
+    monkeypatch.setattr(server, "_post", post)
+    click = getattr(server.click, "fn", server.click)
+    assert "not found" in click(widget_id="stale", pid=123)
