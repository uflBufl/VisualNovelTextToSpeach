index 0000000..1d5dfd9
--- /dev/null
+++ b/tests/test_screenshot_capture.py
@@ -0,0 +1,245 @@
+"""Focused offscreen coverage for target-bound screenshot capture."""
+
+import base64
+import json
+from unittest.mock import Mock
+
+import pytest
+from PySide6.QtCore import QByteArray
+from PySide6.QtGui import QImage, QScreen
+from PySide6.QtWidgets import QApplication, QLabel, QWidget
+from shiboken6 import delete
+
+from pyside6_mcp import bridge
+
+
+@pytest.fixture
+def app():
+    instance = QApplication.instance() or QApplication([])
+    instance.setApplicationName("capture-test")
+    yield instance
+
+
+def _target(app, title="Private dialogue"):
+    window = QWidget()
+    window.setWindowTitle(title)
+    label = QLabel("SECRET DIALOGUE: never log these pixels", window)
+    label.resize(180, 32)
+    window.resize(240, 100)
+    window.show()
+    app.processEvents()
+    return window, label
+
+
+def _assert_no_desktop_capture(monkeypatch):
+    primary_screen = Mock(
+        side_effect=AssertionError("desktop capture must never be invoked")
+    )
+    grab_window = Mock(
+        side_effect=AssertionError("desktop capture must never be invoked")
+    )
+    monkeypatch.setattr(QApplication, "primaryScreen", primary_screen)
+    monkeypatch.setattr(QScreen, "grabWindow", grab_window)
+    return primary_screen, grab_window
+
+
+def _assert_desktop_capture_not_called(mocks):
+    for mock in mocks:
+        mock.assert_not_called()
+
+
+def test_requires_explicit_widget_id_without_desktop_capture(app, monkeypatch):
+    desktop_calls = _assert_no_desktop_capture(monkeypatch)
+
+    result = bridge._qt_screenshot()
+
+    assert result["capture"]["error_code"] == "target_required"
+    assert "widget_id" in result["error"]
+    assert "image" not in result
+    _assert_desktop_capture_not_called(desktop_calls)
+
+
+@pytest.mark.parametrize("state", ["hidden", "closed"])
+def test_hidden_or_closed_target_fails_without_retargeting(app, monkeypatch, state):
+    window, _ = _target(app, "Original")
+    other, _ = _target(app, "Other visible window")
+    widget_id = bridge._widget_id(window)
+    if state == "hidden":
+        window.hide()
+    else:
+        window.close()
+    other.activateWindow()
+    app.processEvents()
+    desktop_calls = _assert_no_desktop_capture(monkeypatch)
+
+    result = bridge._qt_screenshot(widget_id)
+
+    assert result["capture"]["error_code"] == "target_hidden"
+    assert result["capture"]["widget_id"] == widget_id
+    assert "image" not in result
+    _assert_desktop_capture_not_called(desktop_calls)
+    window.deleteLater()
+    other.close()
+    other.deleteLater()
+    app.processEvents()
+
+
+def test_missing_and_stale_targets_fail_without_desktop_capture(app, monkeypatch):
+    desktop_calls = _assert_no_desktop_capture(monkeypatch)
+    missing = bridge._qt_screenshot("no-such-widget-id")
+    assert missing["capture"]["error_code"] == "target_missing"
+
+    window, child = _target(app)
+    widget_id = bridge._widget_id(child)
+    delete(child)
+    stale = bridge._qt_screenshot(widget_id)
+    assert stale["capture"]["error_code"] == "target_missing"
+    assert "image" not in stale
+    _assert_desktop_capture_not_called(desktop_calls)
+    window.close()
+    window.deleteLater()
+    app.processEvents()
+
+
+@pytest.mark.parametrize("widget", [False, True])
+def test_success_is_scoped_to_requested_window_or_widget(
+    app, monkeypatch, caplog, widget
+):
+    caplog.set_level("INFO", logger="pyside6_mcp.bridge")
+    window, child = _target(app)
+    other, _ = _target(app, "Unrequested window")
+    target = child if widget else window
+    widget_id = bridge._widget_id(target)
+    desktop_calls = _assert_no_desktop_capture(monkeypatch)
+
+    result = bridge._qt_screenshot(widget_id)
+
+    assert "error" not in result
+    capture = result["capture"]
+    assert capture["status"] == "success"
+    assert capture["widget_id"] == widget_id
+    assert capture["window_widget_id"] == bridge._widget_id(window)
+    assert capture["window_title"] == "Private dialogue"
+    assert capture["owner_pid"] > 0
+    assert capture["bounds"]["width"] == target.width()
+    assert capture["bounds"]["height"] == target.height()
+    assert capture["output_dimensions"] == {
+        "width": target.width(),
+        "height": target.height(),
+    }
+    assert capture["scope"] == ("isolated-widget" if widget else "isolated-window")
+    raw = base64.b64decode(result["image"])
+    image = QImage()
+    assert image.loadFromData(QByteArray(raw), "PNG")
+    assert (image.width(), image.height()) == (target.width(), target.height())
+    records = [
+        record.message
+        for record in caplog.records
+        if "screenshot_capture" in record.message
+    ]
+    assert records
+    logged = "\n".join(records)
+    assert "SECRET DIALOGUE" not in logged
+    assert result["image"] not in logged
+    assert (
+        json.loads(logged.split("screenshot_capture ", 1)[-1])["widget_id"] == widget_id
+    )
+    _assert_desktop_capture_not_called(desktop_calls)
+    window.close()
+    other.close()
+    window.deleteLater()
+    other.deleteLater()
+    app.processEvents()
+
+
+def test_focus_change_does_not_retarget_explicit_request(app, monkeypatch):
+    original, _ = _target(app, "Requested")
+    other, _ = _target(app, "Focused later")
+    widget_id = bridge._widget_id(original)
+    other.activateWindow()
+    app.processEvents()
+    desktop_calls = _assert_no_desktop_capture(monkeypatch)
+
+    result = bridge._qt_screenshot(widget_id)
+
+    assert result["capture"]["status"] == "success"
+    assert result["capture"]["widget_id"] == widget_id
+    assert result["capture"]["window_title"] == "Requested"
+    _assert_desktop_capture_not_called(desktop_calls)
+    original.close()
+    other.close()
+    original.deleteLater()
+    other.deleteLater()
+    app.processEvents()
+
+
+def test_expired_qt_callback_never_grabs_target(app, monkeypatch):
+    from unittest.mock import Mock
+
+    window, _ = _target(app)
+    grab = Mock()
+    monkeypatch.setattr(window, "grab", grab)
+    result = bridge._qt_screenshot(bridge._widget_id(window), deadline=0)
+    assert result["capture"]["error_code"] == "request_expired"
+    grab.assert_not_called()
+    window.close()
+
+
+def test_target_closed_during_paint_is_not_returned_or_retargeted(app):
+    class ClosingWindow(QWidget):
+        def grab(self):
+            result = super().grab()
+            self.close()
+            return result
+
+    window = ClosingWindow()
+    window.resize(100, 100)
+    window.show()
+    other, _ = _target(app, "Neighbor")
+    widget_id = bridge._widget_id(window)
+    result = bridge._qt_screenshot(widget_id)
+    assert result["capture"]["error_code"] == "target_changed"
+    assert result["capture"]["widget_id"] == widget_id
+    assert "image" not in result
+    other.close()
+
+
+def test_target_resized_during_paint_cannot_mislabel_image_bounds(app):
+    class ResizingWindow(QWidget):
+        def grab(self):
+            result = super().grab()
+            self.resize(self.width() + 10, self.height())
+            return result
+
+    window = ResizingWindow()
+    window.resize(100, 100)
+    window.show()
+    result = bridge._qt_screenshot(bridge._widget_id(window))
+    assert result["capture"]["error_code"] == "target_changed"
+    assert "image" not in result
+    window.close()
+
+
+def test_widget_ids_cannot_alias_a_restarted_application(app):
+    import os
+    import subprocess
+    import sys
+
+    window, _ = _target(app)
+    widget_id = bridge._widget_id(window)
+    other_session = subprocess.check_output(
+        [
+            sys.executable,
+            "-c",
+            "from pyside6_mcp.bridge import _widget_session; print(_widget_session)",
+        ],
+        env={**os.environ, "QT_QPA_PLATFORM": "offscreen"},
+        text=True,
+    ).strip()
+    assert widget_id.startswith(bridge._widget_session + ":")
+    assert other_session != bridge._widget_session
+    assert (
+        bridge._qt_screenshot(other_session + ":0")["capture"]["error_code"]
+        == "target_missing"
+    )
+    window.close()
diff --git a/tests/test_screenshot_server.py b/tests/test_screenshot_server.py
new file mode 100644
index 0000000..f489a7c
--- /dev/null
+++ b/tests/test_screenshot_server.py
@@ -0,0 +1,163 @@
+import base64
+import json
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import httpx
+import pytest
+
+from pyside6_mcp import server
+from pyside6_mcp.launch import inject_root_for
+
+
+def _screenshot(**kwargs):
+    return getattr(server.screenshot, "fn", server.screenshot)(**kwargs)
+
+
+def test_mcp_keeps_png_content_and_same_operation_provenance(monkeypatch):
+    capture = {
+        "correlation_id": "one-operation",
+        "widget_id": "target",
+        "status": "success",
+    }
+    data = {"image": base64.b64encode(b"png").decode(), "capture": capture}
+    monkeypatch.setattr(server, "_get", lambda *a, **k: {"screenshot_contract": 1})
+    monkeypatch.setattr(
+        server,
+        "_request_with_retry",
+        lambda *a, **k: SimpleNamespace(json=lambda: data),
+    )
+    result = _screenshot(widget_id="target", pid=123)
+    assert result.content[0].type == "image"
+    assert base64.b64decode(result.content[0].data) == b"png"
+    assert json.loads(result.content[1].text)["capture"] == capture
+    assert result.meta["capture"] == capture
+
+
+def test_mcp_returns_capture_failure_without_image(monkeypatch):
+    data = {
+        "error": "Target is hidden",
+        "capture": {"status": "failure", "widget_id": "closed"},
+    }
+    response = httpx.Response(
+        409, json=data, request=httpx.Request("GET", "http://bridge/screenshot")
+    )
+    monkeypatch.setattr(server, "_get", lambda *a, **k: {"screenshot_contract": 1})
+
+    def fail(*a, **k):
+        response.raise_for_status()
+
+    monkeypatch.setattr(server, "_request_with_retry", fail)
+    from fastmcp.exceptions import ToolError
+
+    with pytest.raises(ToolError) as error:
+        _screenshot(widget_id="closed", pid=123)
+    assert json.loads(str(error.value)) == data
+
+
+def test_legacy_bridge_is_rejected_before_any_capture(monkeypatch):
+    def legacy(*a, **k):
+        raise RuntimeError("Bridge returned 404")
+
+    monkeypatch.setattr(server, "_get", legacy)
+    request = Mock()
+    monkeypatch.setattr(server, "_request_with_retry", request)
+    with pytest.raises(RuntimeError):
+        _screenshot(widget_id="original", pid=123)
+    request.assert_not_called()
+
+
+def test_transport_retry_keeps_pid_and_widget_after_focus_change(monkeypatch):
+    session = SimpleNamespace(port=54321)
+    resolve = Mock(return_value=session)
+    monkeypatch.setattr(server._sessions, "resolve", resolve)
+    original = {"widget_id": "original-window"}
+    calls = []
+
+    def request(method, path, **kwargs):
+        calls.append((method, path, dict(kwargs["params"])))
+        if len(calls) == 1:
+            raise httpx.ReadError("response lost after focus changed")
+        return httpx.Response(
+            409,
+            json={"error": "original target closed"},
+            request=httpx.Request(method, "http://bridge" + path),
+        )
+
+    monkeypatch.setattr(
+        server, "_client_for", lambda port: SimpleNamespace(request=request)
+    )
+    monkeypatch.setattr(server.time, "sleep", lambda seconds: None)
+    with pytest.raises(httpx.HTTPStatusError):
+        server._request_with_retry("GET", "/screenshot", pid=123, params=original)
+    assert calls == [("GET", "/screenshot", original)] * 2
+    resolve.assert_called_once_with(123)
+
+
+def test_source_injection_contains_fixed_bridge(tmp_path):
+    from pathlib import Path
+
+    import pyside6_mcp
+
+    source = Path(pyside6_mcp.__file__).parent
+    root = Path(inject_root_for(source, dest_root=tmp_path / "inject"))
+    assert (root / "pyside6_mcp/bridge.py").read_bytes() == (
+        source / "bridge.py"
+    ).read_bytes()
+    assert b"grabWindow(" not in (root / "pyside6_mcp/bridge.py").read_bytes()
+
+
+def test_mcp_protocol_still_returns_image_content(monkeypatch):
+    import asyncio
+
+    from fastmcp import Client
+
+    capture = {"correlation_id": "protocol-test", "status": "success"}
+    monkeypatch.setattr(server, "_get", lambda *a, **k: {"screenshot_contract": 1})
+    data = {"image": base64.b64encode(b"png").decode(), "capture": capture}
+    monkeypatch.setattr(
+        server,
+        "_request_with_retry",
+        lambda *a, **k: SimpleNamespace(json=lambda: data),
+    )
+
+    async def check():
+        async with Client(server.mcp) as client:
+            result = await client.call_tool(
+                "screenshot", {"widget_id": "target", "pid": 123}
+            )
+            assert result.content[0].type == "image"
+            assert json.loads(result.content[1].text)["capture"] == capture
+
+    asyncio.run(check())
+
+
+def test_mcp_protocol_returns_failure_provenance_without_image(monkeypatch):
+    import asyncio
+
+    from fastmcp import Client
+
+    data = {
+        "error": "Target is hidden",
+        "capture": {"status": "failure", "widget_id": "closed"},
+    }
+    response = httpx.Response(
+        409, json=data, request=httpx.Request("GET", "http://bridge/screenshot")
+    )
+    monkeypatch.setattr(server, "_get", lambda *a, **k: {"screenshot_contract": 1})
+
+    def fail(*a, **k):
+        response.raise_for_status()
+
+    monkeypatch.setattr(server, "_request_with_retry", fail)
+
+    async def check():
+        async with Client(server.mcp) as client:
+            result = await client.call_tool(
+                "screenshot", {"widget_id": "closed", "pid": 123}, raise_on_error=False
+            )
+            assert result.is_error
+            assert [item.type for item in result.content] == ["text"]
+            assert json.loads(result.content[0].text) == data
+
+    asyncio.run(check())
