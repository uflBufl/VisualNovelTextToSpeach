+"""Qt ownership and input regressions for the developer bridge."""
+import gc
+from unittest.mock import Mock
+
+import pytest
+from PySide6.QtWidgets import QApplication, QComboBox, QLineEdit
+from shiboken6 import delete, getCppPointer
+
+from pyside6_mcp import bridge, server
+
+
+@pytest.fixture
+def app():
+    app = QApplication.instance() or QApplication([])
+    yield app
+    for window in app.topLevelWidgets():
+        window.close()
+        delete(window)
+    gc.collect()
+
+
+@pytest.mark.parametrize("kind", ["clear", "combo"])
+def test_native_child_survives_wrapper_collection_and_remains_actionable(app, kind):
+    if kind == "clear":
+        parent = QLineEdit("previous")
+        parent.setClearButtonEnabled(True)
+        class_name = "QToolButton"
+    else:
+        parent = QComboBox()
+        parent.setEditable(True)
+        parent.setEditText("previous")
+        class_name = "QLineEdit"
+    parent.show()
+    app.processEvents()
+    found = bridge._qt_find({"class": class_name, "visible": True})["widgets"]
+    assert len(found) == 1
+    wid = found[0]["id"]
+    transient = bridge._resolve(wid)
+    pointer = getCppPointer(transient)[0]
+    ref = bridge._widget_registry[wid]
+    del transient
+    gc.collect()
+    assert ref() is None, "fixture must exercise a collected anonymous Qt wrapper"
+    recovered = bridge._resolve(wid)
+    assert getCppPointer(recovered)[0] == pointer
+    assert bridge._widget_id(recovered) == wid
+    if kind == "clear":
+        assert bridge._qt_click_widget(wid, {}) == {"ok": True}
+        assert parent.text() == ""
+    else:
+        assert bridge._qt_type(wid, {"text": " appended"}) == {"ok": True}
+        assert parent.currentText() == "previous appended"
+
+
+def test_destroyed_objects_and_registry_removal_never_reuse_ids(app, record_property):
+    original = QLineEdit()
+    original.show()
+    old_id = bridge._widget_id(original)
+    seen_pointers = {getCppPointer(original)[0]}
+    reused_addresses = 0
+    delete(original)
+    assert bridge._resolve(old_id) is None
+    bridge._widget_registry.pop(old_id)
+    replacements = []
+    for _ in range(20):
+        replacement = QLineEdit()
+        replacement.show()
+        new_id = bridge._widget_id(replacement)
+        pointer = getCppPointer(replacement)[0]
+        reused_addresses += pointer in seen_pointers
+        seen_pointers.add(pointer)
+        assert new_id != old_id
+        assert bridge._resolve(old_id) is None
+        replacements.append(new_id)
+        delete(replacement)
+    assert len(set(replacements)) == 20
+    record_property("reused_native_addresses", reused_addresses)
+
+
+def test_dynamic_property_names_are_decoded_before_lookup(app):
+    editor = QLineEdit()
+    editor.setProperty("example", "value")
+    info = bridge._qt_widget_info(bridge._widget_id(editor))
+    assert info["dynamic_properties"] == {"example": "value"}
+
+
+def test_named_key_and_portable_combo_replace_text_without_literal_chord(app):
+    editor = QLineEdit("previous")
+    editor.show()
+    editor.setFocus()
