+def _capture_record(widget_id: str | None) -> dict:
+    return {
+        "correlation_id": uuid.uuid4().hex,
+        "requested_at": datetime.now(timezone.utc).isoformat(),
+        "captured_at": None,
+        "owner_pid": os.getpid(),
+        "application": os.path.basename(sys.argv[0]),
+        "widget_id": widget_id,
+        "window_widget_id": None,
+        "window_id": None,
+        "window_title": None,
+        "bounds": None,
+        "output_dimensions": None,
+        "method": "QWidget.grab",
+        "scope": None,
+        "status": "failure",
+    }
+
+
+def _capture_failure(capture: dict, code: str, message: str) -> dict:
+    capture["status"] = "failure"
+    capture["error_code"] = code
+    logger.info("screenshot_capture %s", json.dumps(capture))
+    return {"error": message, "capture": capture}
+
+
+def _target_details(target: QWidget, window: QWidget) -> dict:
+    origin = target.mapToGlobal(QPoint(0, 0))
+    return {
+        "window_widget_id": _widget_id(window),
+        "window_id": str(int(window.winId())),
+        "window_title": window.windowTitle(),
+        "scope": "isolated-window" if target is window else "isolated-widget",
+        "bounds": {"x": origin.x(), "y": origin.y(),
+                   "width": target.width(), "height": target.height()},
+    }
+
+
+def _qt_screenshot(widget_id: str | None = None, capture: dict | None = None,
+                   deadline: float | None = None) -> dict:
+    # Resolve once on the Qt thread; focus changes must never retarget a request.
+    capture = dict(capture) if capture is not None else _capture_record(widget_id)
+    if deadline is not None and time.monotonic() >= deadline:
+        return _capture_failure(capture, "request_expired", "Screenshot request expired before Qt capture.")
+    if not widget_id:
+        return _capture_failure(capture, "target_required",
+                                "Screenshot requires widget_id from get_widget_tree; no desktop fallback is allowed.")
+    target = _resolve(widget_id)
+    if target is None or not isValid(target):
+        return _capture_failure(capture, "target_missing",
+                                "Screenshot target is missing or stale; inspect get_widget_tree before retrying.")
+    try:
+        window = target.window()
+        if not isValid(window):
+            return _capture_failure(capture, "target_missing", "Screenshot window is stale.")
+        capture["application"] = QApplication.instance().applicationName() or capture["application"]
+        details = _target_details(target, window)
+        capture.update(details)
+        if not target.isVisible() or not window.isVisible() or window.isMinimized():
+            return _capture_failure(capture, "target_hidden", "Screenshot target is hidden, closed or minimized.")
+        if target.width() <= 0 or target.height() <= 0:
+            return _capture_failure(capture, "target_empty", "Screenshot target has no drawable area.")
+        pixmap = target.grab()
+        # grab() can invoke paint handlers; revalidate the same object, never resolve another.
+        if not isValid(target) or not isValid(window) or not target.isVisible() or not window.isVisible() or window.isMinimized():
+            return _capture_failure(capture, "target_changed", "Screenshot target disappeared during capture.")
+        if target.window() is not window or _target_details(target, window) != details:
+            return _capture_failure(capture, "target_changed", "Screenshot target geometry or identity changed during capture.")
+        if deadline is not None and time.monotonic() >= deadline:
+            return _capture_failure(capture, "request_expired", "Screenshot request expired during capture.")
+        if pixmap.isNull():
+            return _capture_failure(capture, "empty_image", "Screenshot target returned an empty image.")
+        buf = QBuffer()
+        if not buf.open(QIODevice.OpenMode.ReadWrite) or not pixmap.save(buf, "PNG"):
+            return _capture_failure(capture, "encoding_failed", "Could not encode screenshot as PNG.")
+        capture.update(
+            captured_at=datetime.now(timezone.utc).isoformat(),
+            output_dimensions={"width": pixmap.width(), "height": pixmap.height()},
+            status="success",
+        )
+        logger.info("screenshot_capture %s", json.dumps(capture))
+        return {"image": base64.b64encode(bytes(buf.data())).decode(), "capture": capture}
+    except Exception:
+        return _capture_failure(capture, "capture_failed", "Screenshot target could not be captured; inspect app status.")
 
 
