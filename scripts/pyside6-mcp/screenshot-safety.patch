+def _dispatch_main(func, timeout: float = 5.0) -> tuple[dict, int]:
+    """Observe one queued invocation, including a nested modal event loop.
+
+    A nested-loop acknowledgement means dispatch began, not that func returned.
+    No persistent task registry is needed: callers inspect the app before retrying.
+    """
+    sync = threading.Event()
+    lock = threading.Lock()
+    invocation_id = uuid.uuid4().hex
+    outcome = ({"ok": True, "state": "queued", "invocation_id": invocation_id}, 202)
+
+    def run():
+        nonlocal outcome
+        with lock:
+            outcome = ({"ok": True, "state": "dispatched",
+                        "invocation_id": invocation_id}, 202)
+        # Ordinary calls finish before this event is processed. QDialog.exec()
+        # processes it in its nested loop while the original call is still active.
+        QApplication.instance().postEvent(
+            _proxy, _CallEvent(sync.set, threading.Event(), [])
+        )
+        try:
+            result = func()
+            state = "error" if "error" in result else "completed"
+            status = 200
+        except Exception as exc:
+            result, state, status = {"error": str(exc)}, "error", 500
+        if state == "error":
+            # Also surface failures that happen after an asynchronous response.
+            logger.error("Qt invocation %s failed: %s", invocation_id, result["error"])
+        with lock:
+            outcome = ({**result, "state": state, "invocation_id": invocation_id}, status)
+        sync.set()
+
+    QApplication.instance().postEvent(_proxy, _CallEvent(run, threading.Event(), []))
+    sync.wait(timeout)
+    with lock:
+        return outcome
+
